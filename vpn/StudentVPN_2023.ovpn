dev tun
persist-tun
persist-key
data-ciphers AES-128-GCM:AES-128-CBC
data-ciphers-fallback AES-128-CBC
auth SHA256
tls-client
client
resolv-retry infinite
remote vpn-student.samk.fi 1194 udp4
nobind
auth-user-pass
remote-cert-tls server
explicit-exit-notify

